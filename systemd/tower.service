[Unit]
Description=Tower vault-search MCP server (Streamable HTTP, localhost-only)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/tower
EnvironmentFile=%h/.config/tower/env
Environment=TOWER_INDEX_PATH=%h/.local/share/tower/index/vault.db
Environment=TOWER_SEMANTIC_URL=
Environment=TOWER_SEMANTIC_TIMEOUT_SECONDS=45
Environment=TOWER_PLANNED_OFFLINE_NODES=charlie
Environment=TOWER_LOCAL_INDEX_ROLE=alpha-primary
ExecStart=%h/tower/.venv/bin/python %h/tower/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
